<%- include('header') %>
<h1>Gastos del Mes — <%= mesLabel %></h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (gastos.length) { %>
<div class="card">
  <table class="tabla">
    <thead>
      <tr><th>Proveedor</th><th>Fecha</th><th>Importe</th><th>Gastos</th><th>Estado</th></tr>
    </thead>
    <tbody>
      <% gastos.forEach(function(g) { %>
      <tr>
        <td><%= g.proveedor %></td>
        <td><%= g.fecha %></td>
        <td class="num">$<%= g.importe %></td>
        <td class="num">$<%= g.montoDebitado || '0' %></td>
        <td>
          <% if (g.estado && g.estado.indexOf('Validado') !== -1) { %>
            <span class="badge badge-ok"><%= g.estado %></span>
          <% } else if (g.estado && g.estado.indexOf('Sin') !== -1) { %>
            <span class="badge badge-warn"><%= g.estado %></span>
          <% } else if (g.estado && g.estado.indexOf('No validado') !== -1) { %>
            <span class="badge badge-warn"><%= g.estado %></span>
          <% } else { %>
            <span class="badge"><%= g.estado %></span>
          <% } %>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } else if (!error) { %>
<div class="msg warning">No hay gastos cargados para este mes.</div>
<% } %>
<%- include('footer') %>
