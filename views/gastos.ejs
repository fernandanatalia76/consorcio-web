<%- include('header') %>
<% function money(v){ v=String(v==null?'':v).trim().replace(/^\$\s*/,''); return '$'+(v||'0'); } %>
<%
  function comp(v){
    var s = String(v==null?'':v).trim();
    if (!s) return '';
    if (/^\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{2,4}$/.test(s)) return '';
    return s;
  }
  function toNum(v){
    if (v==null) return 0;
    var s = String(v).replace(/[^\d.,-]/g,'');
    if (!s) return 0;
    if (s.indexOf(',')!==-1) s = s.replace(/\./g,'').replace(',','.');
    else if (s.indexOf('.')!==-1) {
      var partes = s.split('.');
      if (partes[partes.length-1].length === 3) s = partes.join('');
    }
    var n = parseFloat(s); return isNaN(n) ? 0 : n;
  }
  function sumCol(arr, campo){
    var total = 0;
    arr.forEach(function(x){ total += toNum(x[campo]); });
    return '$' + total.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
  }
  function fmtFecha(d){
    if (!d) return '';
    var f = new Date(d);
    return f.toLocaleString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
  }
%>
<h1>Gastos y Saldos<% if (mesLabel) { %> — <%= mesLabel %><% } %></h1>
<style>
  @page { size: landscape; margin: 12mm; }
  @media print {
    .cache-banner, .btn, form, .cf-sidebar { display: none !important; }
    .gastos-grid { display: block !important; }
    *, *::before, *::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }
  }
</style>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (cache && cache.publicado && cache.esAdmin) { %>
<div style="text-align:right;margin-bottom:10px">
  <button type="button" class="btn btn-sm" onclick="window.print()">🖨️ Generar PDF</button>
</div>
<% } %>
<% if (cache && cache.publicado) { %>
<div class="cache-banner">
  <span class="cache-info">📅 Datos publicados el <strong><%= fmtFecha(cache.fechaHora) %></strong></span>
  <% if (cache.esAdmin) { %>
    <form method="POST" action="/admin/gastos/actualizar" style="display:inline">
      <button type="submit" class="btn btn-sm">🔄 Actualizar datos</button>
    </form>
  <% } %>
</div>
<% } else { %>
<div class="cache-vacio">
  <div class="cache-vacio-icono">📋</div>
  <h3>La administración todavía no publicó los datos de Gastos</h3>
  <% if (cache && cache.esAdmin) { %>
    <p>Tocá el botón para leer los datos de la planilla y publicarlos para todos los consorcistas.</p>
    <form method="POST" action="/admin/gastos/actualizar">
      <button type="submit" class="btn btn-primary" style="width:auto;padding:10px 20px">🔄 Publicar / Actualizar datos</button>
    </form>
  <% } else { %>
    <p>Cuando la administración actualice los datos del mes, van a aparecer acá.</p>
  <% } %>
</div>
<% } %>
<% if (cache && cache.publicado) { %>
<%
  var cfHist = (typeof cashflowHistorico !== 'undefined' && cashflowHistorico) ? cashflowHistorico : [];
  var cfExtraHist = (typeof cashflowExtraHistorico !== 'undefined' && cashflowExtraHistorico) ? cashflowExtraHistorico : [];
%>
<style>
  .cf-sidebar{display:flex;flex-direction:column}
  .cf-historico-inversiones{border-top:3px solid #1a4a6e}
</style>
<div class="gastos-grid">
  <aside class="cf-sidebar">
  <div class="card cf-historico">
    <h3>Cash Flow — histórico</h3>
    <% if (cfHist.length) { %>
      <div class="cf-lista">
        <% cfHist.slice().reverse().forEach(function(cf){ %>
          <div class="cf-item">
            <div class="cf-mes"><%= cf.mes %></div>
            <div class="cf-linea"><span>Saldo inicial</span><strong><%= money(cf.saldoInicial) %></strong></div>
            <div class="cf-linea"><span>Créditos</span><strong class="cf-verde"><%= money(cf.creditosCobrados) %></strong></div>
            <div class="cf-linea"><span>Débitos</span><strong class="cf-rojo"><%= money(cf.debitosProveedores) %></strong></div>
            <div class="cf-linea cf-total"><span>Saldo final</span><strong><%= money(cf.saldoFinal) %></strong></div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="nota">Sin datos de Cash Flow.</p>
    <% } %>
  </div>
  <div class="card cf-historico cf-historico-inversiones" style="margin-top:16px">
    <h3>Cash Flow Inversiones — histórico</h3>
    <p class="nota" style="margin-top:-6px;margin-bottom:10px">Fondos comunes de inversión (obras extraordinarias)</p>
    <% if (cfExtraHist.length) { %>
      <div class="cf-lista">
        <% cfExtraHist.slice().reverse().forEach(function(cf){ %>
          <div class="cf-item">
            <div class="cf-mes"><%= cf.mes %></div>
            <div class="cf-linea"><span>Saldo inicial</span><strong><%= money(cf.saldoInicial) %></strong></div>
            <div class="cf-linea"><span>Depositado</span><strong class="cf-verde"><%= money(cf.depositado) %></strong></div>
            <div class="cf-linea"><span>Rescatado</span><strong class="cf-rojo"><%= money(cf.rescatado) %></strong></div>
            <div class="cf-linea cf-total"><span>Saldo final</span><strong><%= money(cf.saldoFinal) %></strong></div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="nota">Sin datos de inversiones todavía.</p>
    <% } %>
  </div>
  </aside>
  <section class="gastos-main">
    <%
      function esExtra(g){
        var c = String(g.categoria||'').toLowerCase();
        // FIX: "Ingreso extraordinarias" (fondos comunes de inversión)
        // contiene la palabra "extraordinari" pero NO es un gasto
        // extraordinario — es un débito real que va en Gastos ordinarios.
        if (c.indexOf('ingreso extraordinar') !== -1) return false;
        return c.indexOf('extraordinari') !== -1;
      }
      var ordinarios = gastos.filter(function(g){ return !esExtra(g); });
      var extraordinarios = gastos.filter(esExtra);
      var recTrab = (typeof recaudacionTrabajos !== 'undefined' && recaudacionTrabajos) ? recaudacionTrabajos : [];
      // FIX: "Total débitos" del resumen ahora es Gastos ordinarios +
      // Impuestos y Comisiones bancarias (lo que realmente se ve abajo en
      // el detalle), en vez del dato de la solapa Cash Flow que podía no
      // coincidir.
      var totDebOrdinarios = 0; ordinarios.forEach(function(g){ totDebOrdinarios += toNum(g.montoDebitado); });
      var totDebImpuestos  = 0; impuestos.forEach(function(g){ totDebImpuestos += toNum(g.montoDebitado); });
      var totDebResumen = totDebOrdinarios + totDebImpuestos;
    %>
    <% if (cashflow) { %>
    <div class="card resumen-card">
      <h3>Resumen — <%= mesLabel %></h3>
      <div class="resumen-grid">
        <div class="resumen-item" style="background:#f1f3f4"><div class="resumen-label">Saldo inicial</div><div class="resumen-valor"><%= money(cashflow.saldoInicial) %></div></div>
        <div class="resumen-item" style="background:#e6f4ea"><div class="resumen-label">Créditos cobrados</div><div class="resumen-valor"><%= money(cashflow.creditosCobrados) %></div></div>
        <div class="resumen-item" style="background:#fce8e6"><div class="resumen-label">Total débitos</div><div class="resumen-valor">$<%= totDebResumen.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2}) %></div></div>
        <div class="resumen-item" style="background:#e8f0fe"><div class="resumen-label">Saldo final</div><div class="resumen-valor"><%= money(cashflow.saldoFinal) %></div></div>
      </div>
    </div>
    <% } %>
    <% if (typeof cashflowExtra !== 'undefined' && cashflowExtra) { %>
    <div class="card resumen-card">
      <h3>Resumen — Inversiones</h3>
      <div class="resumen-grid">
        <div class="resumen-item" style="background:#f1f3f4"><div class="resumen-label">Saldo inicial</div><div class="resumen-valor"><%= money(cashflowExtra.saldoInicial) %></div></div>
        <div class="resumen-item" style="background:#e8f0fe"><div class="resumen-label">Depositado</div><div class="resumen-valor"><%= money(cashflowExtra.depositado) %></div></div>
        <div class="resumen-item" style="background:#e6f4ea"><div class="resumen-label">Rescatado</div><div class="resumen-valor"><%= money(cashflowExtra.rescatado) %></div></div>
        <div class="resumen-item" style="background:#e8f0fe"><div class="resumen-label">Saldo final</div><div class="resumen-valor"><%= money(cashflowExtra.saldoFinal) %></div></div>
      </div>
    </div>
    <% } %>
    <% if (ordinarios.length) { %>
    <div class="card"><h3>Detalle de facturas — Gastos ordinarios</h3><div style="overflow-x:auto">
      <table class="tabla tabla-striped rtable"><thead><tr><th>Proveedor</th><th>N° Comprobante</th><th>Fecha</th><th>Importe</th><th>Gastos</th><th>Estado</th></tr></thead><tbody>
        <% ordinarios.forEach(function(g) { %>
        <tr>
          <td data-label="Proveedor"><%= g.proveedor %></td>
          <td data-label="N° Comprobante"><%= comp(g.nroComprobante) %></td>
          <td data-label="Fecha"><%= g.fecha %></td>
          <td data-label="Importe"><%= money(g.importe) %></td>
          <td data-label="Gastos"><%= money(g.montoDebitado) %></td>
          <td data-label="Estado"><% if(g.estado&&g.estado.indexOf('Validado')!==-1){%><span class="badge badge-total"><%= g.estado %></span><%}else if(g.estado&&(g.estado.indexOf('Sin')!==-1||g.estado.indexOf('No ')!==-1)){%><span class="badge badge-pendiente"><%= g.estado %></span><%}else{%><span class="badge"><%= g.estado %></span><%}%></td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot><tr class="fila-total"><th>TOTAL</th><th></th><th></th><th></th><th data-label="Gastos"><%= sumCol(ordinarios,'montoDebitado') %></th><th></th></tr></tfoot>
      </table></div></div>
    <% } %>
    <% if (extraordinarios.length) { %>
    <div class="card"><h3>Gastos extraordinarios</h3><div style="overflow-x:auto">
      <table class="tabla tabla-striped rtable"><thead><tr><th>Proveedor</th><th>N° Comprobante</th><th>Fecha</th><th>Categoría</th><th>Importe</th><th>Gastos</th><th>Estado</th></tr></thead><tbody>
        <% extraordinarios.forEach(function(g) { %>
        <tr>
          <td data-label="Proveedor"><%= g.proveedor %></td>
          <td data-label="N° Comprobante"><%= comp(g.nroComprobante) %></td>
          <td data-label="Fecha"><%= g.fecha %></td>
          <td data-label="Categoría"><%= g.categoria %></td>
          <td data-label="Importe"><%= money(g.importe) %></td>
          <td data-label="Gastos"><%= money(g.montoDebitado) %></td>
          <td data-label="Estado"><span class="badge"><%= g.estado %></span></td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot><tr class="fila-total"><th colspan="4">TOTAL</th><th data-label="Importe"><%= sumCol(extraordinarios,'importe') %></th><th data-label="Gastos"><%= sumCol(extraordinarios,'montoDebitado') %></th><th></th></tr></tfoot>
      </table></div></div>
    <% } %>
    <% if (impuestos.length) { %>
    <div class="card"><h3>Impuestos y Comisiones bancarias</h3><div style="overflow-x:auto">
      <table class="tabla rtable"><thead><tr><th>Concepto</th><th>N° Comprobante</th><th>Gastos</th><th>Estado</th></tr></thead><tbody>
        <% impuestos.forEach(function(g) { %>
        <tr>
          <td data-label="Concepto"><%= g.proveedor %></td>
          <td data-label="N° Comprobante"><%= comp(g.nroComprobante) %></td>
          <td data-label="Gastos"><%= money(g.montoDebitado) %></td>
          <td data-label="Estado"><span class="badge badge-total"><%= g.estado %></span></td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot><tr class="fila-total"><th>TOTAL</th><th></th><th data-label="Gastos"><%= sumCol(impuestos,'montoDebitado') %></th><th></th></tr></tfoot>
      </table></div></div>
    <% } %>
    <% if (recTrab.length) { %>
    <div class="card"><h3>Detalle recaudación para trabajos</h3><div style="overflow-x:auto">
      <table class="tabla tabla-striped rtable"><thead><tr><th>Proveedor</th><th>N° Comprobante</th><th>Fecha</th><th>Importe</th><th>Gastos</th><th>Estado</th></tr></thead><tbody>
        <% recTrab.forEach(function(g) { %>
        <tr>
          <td data-label="Proveedor"><%= g.proveedor %></td>
          <td data-label="N° Comprobante"><%= comp(g.nroComprobante) %></td>
          <td data-label="Fecha"><%= g.fecha %></td>
          <td data-label="Importe"><%= money(g.importe) %></td>
          <td data-label="Gastos"><%= money(g.montoDebitado) %></td>
          <td data-label="Estado"><span class="badge"><%= g.estado %></span></td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot><tr class="fila-total"><th>TOTAL</th><th></th><th></th><th></th><th data-label="Gastos"><%= sumCol(recTrab,'montoDebitado') %></th><th></th></tr></tfoot>
      </table></div></div>
    <% } %>
  </section>
</div>
<div class="pdf-footer" style="display:none">Powered by Flowit</div>
<style>
  @media print {
    .pdf-footer { display:block !important; text-align:center; margin-top:24px; padding-top:12px; border-top:1px solid #ddd; font-size:11px; color:#5f5e5a; }
  }
</style>
<% } %>
<%- include('footer') %>
