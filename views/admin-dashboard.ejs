<%- include('header') %>
<% function money(v){ v=String(v==null?'':v).trim().replace(/^\$\s*/,''); return '$'+(v||'0'); } %>
<%
  var camposConsorcio = [
    'Nombre consorcio',
    'CUIT',
    'CBU Santander',
    'Mes activo',
    'Recargo 2do vencimiento (%)',
    'Día 1er vencimiento',
    'Día 2do vencimiento',
    'Extraordinaria activa (monto mensual)',
    'Extraordinaria Cuotas restantes'
  ];
  function norm(s){ return String(s||'').toLowerCase().replace(/\s+/g,' ').trim(); }
  var diKeys = Object.keys(di);
  function valorDe(label){
    var k = diKeys.find(function(dk){ return norm(dk) === norm(label); });
    return k ? di[k] : '';
  }
%>
<h1>Panel de Administración</h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (msg) { %><div class="msg success"><%= msg %></div><% } %>

<div class="grid-2">
  <div class="card">
    <h3>Datos del Consorcio</h3>
    <table class="tabla-detalle">
      <% camposConsorcio.forEach(function(label){ var v = valorDe(label); %>
        <tr><th><%= label %></th><td><%= (v===''||v==null) ? '—' : v %></td></tr>
      <% }); %>
    </table>
  </div>
  <div class="card">
    <h3>Cash Flow</h3>
    <% if (cashflow.length) { %>
    <div style="overflow-x:auto">
    <table class="tabla rtable"><thead><tr><th>Mes</th><th>Créditos</th><th>Débitos</th><th>Saldo Final</th><th>Deuda proveedores</th></tr></thead><tbody>
      <% cashflow.forEach(function(cf) { %>
      <tr>
        <td data-label="Mes"><%= cf.mes %></td>
        <td data-label="Créditos"><%= money(cf.creditosCobrados) %></td>
        <td data-label="Débitos"><%= money(cf.debitosProveedores) %></td>
        <td data-label="Saldo Final"><%= money(cf.saldoFinal) %></td>
        <td data-label="Deuda proveedores"><%= money(cf.deudaProveedores) %></td>
      </tr>
      <% }); %>
    </tbody></table>
    </div>
    <% } else { %><p>Sin datos de Cash Flow.</p><% } %>
  </div>
</div>

<div class="card">
  <h3>Usuarios pendientes de activación</h3>
  <% if (pendientes.length) { %>
  <div style="overflow-x:auto">
  <table class="tabla rtable"><thead><tr><th>UF</th><th>CUIT</th><th>Propietario</th><th>Email</th><th>Acción</th></tr></thead><tbody>
    <% pendientes.forEach(function(u) { %>
    <tr>
      <td data-label="UF"><%= u.uf %></td>
      <td data-label="CUIT"><%= u.cuit||'' %></td>
      <td data-label="Propietario"><%= u.propietario %></td>
      <td data-label="Email"><%= u.email||'' %></td>
      <td data-label="Acción">
        <div style="display:flex;gap:4px;justify-content:flex-end;flex-wrap:wrap;align-items:center">
          <form method="POST" action="/admin/activar" style="display:flex;gap:4px">
            <input type="hidden" name="uf" value="<%= u.uf %>">
            <input type="text" name="password" placeholder="Contraseña" required style="width:120px">
            <button type="submit" class="btn btn-sm">Activar</button>
          </form>
          <form method="POST" action="/admin/eliminar"
                onsubmit="return confirm('¿Rechazar la solicitud de UF <%= u.uf %> (<%= u.propietario %>)?\n\nSe borra el registro; si quiere volver a entrar, tiene que registrarse otra vez.');">
            <input type="hidden" name="uf" value="<%= u.uf %>">
            <button type="submit" class="btn btn-sm" style="background:#c5221f">Rechazar</button>
          </form>
        </div>
      </td>
    </tr>
    <% }); %>
  </tbody></table>
  </div>
  <% } else { %><p>No hay solicitudes pendientes.</p><% } %>
</div>

<div class="card">
  <h3>Usuarios activos</h3>
  <% var activos = usuarios.filter(function(u){return u.activo;}); %>
  <% if (activos.length) { %>
  <div style="overflow-x:auto">
  <table class="tabla rtable"><thead><tr><th>UF</th><th>Propietario</th><th>Email</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    <% activos.forEach(function(u) { %>
    <tr>
      <td data-label="UF"><%= u.uf %></td>
      <td data-label="Propietario"><%= u.propietario %></td>
      <td data-label="Email"><%= u.email||'' %></td>
      <td data-label="Estado"><span class="badge badge-total">Activo</span></td>
      <td data-label="Acciones">
        <div style="display:flex;gap:4px;justify-content:flex-end;flex-wrap:wrap">
          <form method="POST" action="/admin/blanquear" style="display:flex;gap:4px">
            <input type="hidden" name="uf" value="<%= u.uf %>">
            <input type="text" name="password" placeholder="Nueva clave" required style="width:100px">
            <button type="submit" class="btn btn-sm">Blanquear</button>
          </form>
          <form method="POST" action="/admin/desactivar"
                onsubmit="return confirm('¿Dar de baja a UF <%= u.uf %>? Pierde el acceso pero queda en la lista.');">
            <input type="hidden" name="uf" value="<%= u.uf %>">
            <button type="submit" class="btn btn-sm" style="background:#e65100">Baja</button>
          </form>
          <form method="POST" action="/admin/eliminar"
                onsubmit="return confirm('¿ELIMINAR definitivamente a UF <%= u.uf %> (<%= u.propietario %>)?\n\nEl registro se borra; si vuelve a necesitar entrar, debe registrarse de nuevo.');">
            <input type="hidden" name="uf" value="<%= u.uf %>">
            <button type="submit" class="btn btn-sm" style="background:#c5221f">Eliminar</button>
          </form>
        </div>
      </td>
    </tr>
    <% }); %>
  </tbody></table>
  </div>
  <% } else { %><p>No hay usuarios activos.</p><% } %>
</div>

<div class="grid-2">
  <div class="card">
    <h3>🔐 Cambiar contraseña de admin</h3>
    <form method="POST" action="/admin/cambiar-password" style="display:flex;gap:8px;align-items:end">
      <div style="flex:1"><label>Nueva contraseña</label><input type="text" name="password" required></div>
      <button type="submit" class="btn btn-sm" style="margin-bottom:2px">Cambiar</button>
    </form>
    <p class="nota" style="margin-top:8px">Queda guardada en la planilla (no se pierde al reiniciar).</p>
  </div>
  <div class="card">
    <h3>✉️ Probar envío de email</h3>
    <form method="POST" action="/admin/test-email" style="display:flex;gap:8px;align-items:end">
      <div style="flex:1"><label>Enviar prueba a</label><input type="email" name="destino" placeholder="(por defecto, el admin)"></div>
      <button type="submit" class="btn btn-sm" style="margin-bottom:2px">Enviar prueba</button>
    </form>
  </div>
</div>
<%- include('footer') %>
