<%- include('header') %>
<div class="auth-card">
  <h1><%= consorcioNombre || 'Consorcio' %></h1>
  <h2>Olvidé mi contraseña</h2>
  <% if (error) { %><div class="msg error"><%= error %></div><% } %>
  <% if (ok) { %>
    <div class="msg success">✅ Si los datos coinciden con una cuenta activa, te enviamos una contraseña nueva por email. Revisá tu bandeja de entrada (y spam).</div>
  <% } else { %>
  <form method="POST" action="/olvide-password">
    <input type="hidden" name="consorcioId" value="<%= consorcioId %>">
    <label>N° de Unidad Funcional</label>
    <input type="text" name="uf" placeholder="Ej: 10" required>
    <label>Soy</label>
    <div class="tipo-radios">
      <label class="tipo-opt"><input type="radio" name="tipo" value="propietario" checked> Propietario</label>
      <label class="tipo-opt"><input type="radio" name="tipo" value="inquilino"> Inquilino</label>
    </div>
    <label>Email registrado</label>
    <input type="email" name="email" placeholder="El mismo con el que te registraste" required>
    <button type="submit" class="btn btn-primary">Enviar nueva contraseña</button>
  </form>
  <% } %>
  <p class="auth-link"><a href="/login?c=<%= encodeURIComponent(consorcioId) %>">← Volver al login</a></p>
</div>
<%- include('footer') %>
