<%- include('header') %>
<h1>Liquidación Completa — <%= mesLabel %></h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (liq.datos.length) { %>
<div class="card" style="overflow-x:auto">
  <table class="tabla">
    <thead>
      <tr><th>UF</th><th>Depto</th><th>Propietario</th><th>Adeudadas</th><th>Pagos</th><th>Deuda</th><th>Exp Mes</th><th>Extra</th><th>1er Venc</th><th>2do Venc</th></tr>
    </thead>
    <tbody>
      <% liq.datos.forEach(function(d) { %>
      <tr>
        <td><%= d.uf %></td>
        <td><%= d.depto %></td>
        <td><%= d.propietario %></td>
        <td class="num">$<%= d.expAdeudadas %></td>
        <td class="num">$<%= d.pagos %></td>
        <td class="num bold">$<%= d.deuda %></td>
        <td class="num">$<%= d.expMes %></td>
        <td class="num">$<%= d.extraordinaria %></td>
        <td class="num bold">$<%= d.venc1 %></td>
        <td class="num">$<%= d.venc2 %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } else if (!error) { %>
<div class="msg warning">No se encontró la solapa de liquidación para este mes.</div>
<% } %>
<%- include('footer') %>
