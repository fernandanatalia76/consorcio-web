<%- include('header') %>
<h1>Liquidación Completa<% if (mesLabel) { %> — <%= mesLabel %><% } %></h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>

<% if (cache && cache.publicado) { %>
<div class="cache-banner">
  <span class="cache-info">📅 Datos publicados el <strong><%= new Date(cache.fechaHora).toLocaleString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></strong></span>
  <% if (cache.esAdmin) { %>
    <form method="POST" action="/admin/liquidacion/actualizar" style="display:inline">
      <input type="hidden" name="origen" value="/liquidacion-completa">
      <button type="submit" class="btn btn-sm">🔄 Actualizar datos</button>
    </form>
  <% } %>
</div>
<% } else { %>
<div class="cache-vacio">
  <div class="cache-vacio-icono">📋</div>
  <h3>La administración todavía no publicó los datos de Liquidación</h3>
  <% if (cache && cache.esAdmin) { %>
    <p>Tocá el botón para leer los datos de la planilla y publicarlos.</p>
    <form method="POST" action="/admin/liquidacion/actualizar">
      <input type="hidden" name="origen" value="/liquidacion-completa">
      <button type="submit" class="btn btn-primary" style="width:auto;padding:10px 20px">🔄 Publicar / Actualizar datos</button>
    </form>
  <% } else { %>
    <p>Cuando la administración actualice los datos, van a aparecer acá.</p>
  <% } %>
</div>
<% } %>

<% if (cache && cache.publicado && typeof misUfs !== 'undefined' && misUfs && misUfs.length) { %>
<div class="msg success" style="background:#e8f0fe;color:#1a4a6e">
  <% if (misUfs.length === 1) { %>Tu unidad (UF <%= misUfs[0] %>) aparece resaltada en la tabla.<% } else { %>Tus unidades (UF <%= misUfs.join(', UF ') %>) aparecen resaltadas en la tabla.<% } %>
</div>
<% } %>

<% if (cache && cache.publicado && liq && liq.datos && liq.datos.length) { %>
<div class="card" style="overflow-x:auto">
  <table class="tabla tabla-striped rtable">
    <thead>
      <tr>
        <th>UF</th><th>Depto</th><th>Propietario</th><th>% Coef</th>
        <th>Exp. Adeudadas</th><th>Pagos</th><th class="col-deuda">Deuda</th>
        <th>Exp de Mes</th><th>Extraordinaria</th><th>Sum</th>
        <th>Destapación</th><th>Bicis</th>
        <th class="col-venc1">1er Venc</th><th class="col-venc2">2do Venc</th>
      </tr>
    </thead>
    <tbody>
      <% liq.datos.forEach(function(d) { %>
      <tr<% if (typeof misUfs !== 'undefined' && misUfs && misUfs.indexOf(d.uf) !== -1) { %> class="fila-propia"<% } %>>
        <td data-label="UF"><strong><%= d.uf %></strong></td>
        <td data-label="Depto"><%= d.depto %></td>
        <td data-label="Propietario"><%= d.propietario %></td>
        <td data-label="% Coef"><%= d.coef %></td>
        <td data-label="Exp. Adeudadas">$<%= d.expAdeudadas %></td>
        <td data-label="Pagos">$<%= d.pagos %></td>
        <td data-label="Deuda" class="col-deuda"><strong>$<%= d.deuda %></strong></td>
        <td data-label="Exp de Mes">$<%= d.expMes %></td>
        <td data-label="Extraordinaria">$<%= d.extraordinaria %></td>
        <td data-label="Sum">$<%= d.sum %></td>
        <td data-label="Destapación">$<%= d.destapacion %></td>
        <td data-label="Bicis">$<%= d.bicis %></td>
        <td data-label="1er Venc" class="col-venc1"><strong>$<%= d.venc1 %></strong></td>
        <td data-label="2do Venc" class="col-venc2"><strong>$<%= d.venc2 %></strong></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } else if (cache && cache.publicado && !error) { %>
<div class="msg warning">No hay datos de liquidación para <%= mesLabel %>.</div>
<% } %>
<%- include('footer') %>
