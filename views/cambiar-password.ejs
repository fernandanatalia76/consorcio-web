<%- include('header') %>
<h1>Cambiar mi contraseña</h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (ok) { %><div class="msg success">✅ Contraseña actualizada correctamente.</div><% } %>
<div class="card" style="max-width:420px">
  <form method="POST" action="/mi-cuenta/cambiar-password">
    <label>Contraseña actual</label>
    <input type="password" name="actual" required style="width:100%;padding:10px;margin-bottom:12px">
    <label>Contraseña nueva</label>
    <input type="password" name="nueva" required minlength="4" style="width:100%;padding:10px;margin-bottom:12px">
    <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
  </form>
</div>
<%- include('footer') %>
