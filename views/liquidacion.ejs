<%- include('header') %>
<%
  function toNum(v){
    if (v==null) return 0;
    var s = String(v).replace(/[^\d.,-]/g,'');
    if (!s) return 0;
    if (s.indexOf(',')!==-1) {
      s = s.replace(/\./g,'').replace(',','.');
    } else if (s.indexOf('.')!==-1) {
      var partes = s.split('.');
      var ultima = partes[partes.length-1];
      if (ultima.length === 3) s = partes.join('');
    }
    var n = parseFloat(s); return isNaN(n) ? 0 : n;
  }
  function money(v){
    var n = toNum(v);
    var neg = n < 0; n = Math.abs(n);
    var partes = n.toFixed(2).split('.');
    var entero = partes[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    return (neg?'-':'') + '$' + entero + ',' + partes[1];
  }
%>
<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
  <h1 style="margin:0">Mi Liquidación<% if (mesLabel) { %> — <%= mesLabel %><% } %></h1>
  <a href="/mi-cuenta/cambiar-password" class="btn btn-primary" style="text-decoration:none;white-space:nowrap;padding:12px 20px;font-size:15px">🔐 Cambiar mi contraseña</a>
</div>
<style>
  /* FIX: tarjetas más chatas (menos alto) y con espacio entre ellas */
  .liq-card { margin-bottom: 24px; padding-top: 12px; padding-bottom: 12px; }
  .liq-head { padding-top: 4px; padding-bottom: 4px; }
  .liq-total-box { padding-top: 8px; padding-bottom: 8px; }
  .liq-total-monto { line-height: 1.2; }
  .liq-detalle { padding-top: 6px; padding-bottom: 6px; }
  .liq-det-item { padding-top: 4px; padding-bottom: 4px; }
</style>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (cache && cache.publicado) { %>
<div class="cache-banner">
  <span class="cache-info">📅 Datos publicados el <strong><%= new Date(cache.fechaHora).toLocaleString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></strong></span>
  <% if (cache.esAdmin) { %>
    <form method="POST" action="/admin/liquidacion/actualizar" style="display:inline">
      <input type="hidden" name="origen" value="/mi-liquidacion">
      <button type="submit" class="btn btn-sm">🔄 Actualizar datos</button>
    </form>
  <% } %>
</div>
<% } else { %>
<div class="cache-vacio">
  <div class="cache-vacio-icono">📋</div>
  <h3>La administración todavía no publicó los datos de Liquidación</h3>
  <% if (cache && cache.esAdmin) { %>
    <p>Tocá el botón para leer los datos de la planilla y publicarlos para todos los consorcistas.</p>
    <form method="POST" action="/admin/liquidacion/actualizar">
      <input type="hidden" name="origen" value="/mi-liquidacion">
      <button type="submit" class="btn btn-primary" style="width:auto;padding:10px 20px">🔄 Publicar / Actualizar datos</button>
    </form>
  <% } else { %>
    <p>Cuando la administración actualice los datos del mes, van a aparecer acá.</p>
  <% } %>
</div>
<% } %>
<% if (typeof comunicados !== 'undefined' && comunicados && comunicados.length) { %>
  <% comunicados.forEach(function(com){ %>
    <div class="alerta-legal comunicado-item" data-comunicado-id="<%= com.fila %>" style="background:#e8f0fe;border-color:#1a4a6e;position:relative">
      <div class="alerta-icono">📢</div>
      <div class="alerta-texto">
        <strong>Comunicado de la administración</strong> <span class="nota">(<%= com.fecha %>)</span><br>
        <%= com.mensaje %>
      </div>
      <button type="button" class="comunicado-cerrar" onclick="cerrarComunicado(this)" aria-label="Cerrar" style="position:absolute;top:8px;right:10px;background:none;border:none;font-size:18px;cursor:pointer;color:#1a4a6e;line-height:1">✕</button>
    </div>
  <% }); %>
  <script>
    (function(){
      var descartados = JSON.parse(localStorage.getItem('comunicadosDescartados') || '[]');
      document.querySelectorAll('.comunicado-item').forEach(function(el){
        if (descartados.indexOf(el.getAttribute('data-comunicado-id')) !== -1) el.style.display = 'none';
      });
    })();
    function cerrarComunicado(btn){
      var el = btn.closest('.comunicado-item');
      var id = el.getAttribute('data-comunicado-id');
      var descartados = JSON.parse(localStorage.getItem('comunicadosDescartados') || '[]');
      if (descartados.indexOf(id) === -1) descartados.push(id);
      localStorage.setItem('comunicadosDescartados', JSON.stringify(descartados));
      el.style.display = 'none';
    }
  </script>
<% } %>
<% if (cache && cache.publicado) { %>
<section class="gastos-main">
  <% if (datos && datos.length) { %>
  <% datos.forEach(function(item, idx) {
       var dato = item.dato;
       var tipoLabel = item.tipo === 'inquilino' ? 'inquilino' : 'propietario';
  %>
    <% if (dato) {
         var deudaNum = toNum(dato.deuda);
         var expMesNum = toNum(dato.expMes);
         var mostrarAdvertencia = deudaNum > 0 && expMesNum > 0 && deudaNum > (expMesNum * 2);
    %>
      <% if (mostrarAdvertencia) { %>
      <div class="alerta-legal">
        <div class="alerta-icono">⚠️</div>
        <div class="alerta-texto">
          <strong>Aviso importante</strong><br>
          De no abonar el monto adeudado de la UF <%= item.uf %>, se iniciarán las acciones legales correspondientes.
        </div>
      </div>
      <% } %>
      <div class="liq-card">
        <div class="liq-head">
          <div class="liq-titulo">
            <span class="liq-uf">UF <%= item.uf %></span>
            <% var desc = []; if (item.depto) desc.push(item.depto); if (item.tipoUf) desc.push(item.tipoUf); %>
            <% if (desc.length) { %><span class="liq-desc"><%= desc.join(' · ') %></span><% } %>
          </div>
          <span class="chip-tipo <%= tipoLabel %>"><%= tipoLabel %></span>
        </div>
        <div class="liq-total-box">
          <div class="liq-total-venc">
            <div class="liq-total-lbl">Total a pagar hasta <%= dia1 %>/<%= mesVenc %>/<%= anioVenc %></div>
            <div class="liq-total-monto verde"><%= money(dato.venc1) %></div>
          </div>
          <div class="liq-total-sep"></div>
          <div class="liq-total-venc">
            <div class="liq-total-lbl">Con recargo hasta <%= dia2 %>/<%= mesVenc %></div>
            <div class="liq-total-monto naranja"><%= money(dato.venc2) %></div>
          </div>
        </div>
        <div class="liq-detalle">
          <div class="liq-det-item">
            <div class="liq-det-lbl">Exp. mes anterior</div>
            <div class="liq-det-val"><%= money(dato.expAdeudadas) %></div>
          </div>
          <div class="liq-det-item liq-det-deuda">
            <div class="liq-det-lbl">Deuda</div>
            <div class="liq-det-val"><%= money(dato.deuda) %></div>
          </div>
          <div class="liq-det-item">
            <div class="liq-det-lbl">Exp. mes</div>
            <div class="liq-det-val"><%= money(dato.expMes) %></div>
          </div>
          <div class="liq-det-item">
            <div class="liq-det-lbl">Extraord.</div>
            <div class="liq-det-val"><%= money(dato.extraordinaria) %></div>
          </div>
          <% if (toNum(dato.destapacion) > 0) { %>
          <div class="liq-det-item">
            <div class="liq-det-lbl">Destapación</div>
            <div class="liq-det-val"><%= money(dato.destapacion) %></div>
          </div>
          <% } %>
          <% if (toNum(dato.bicis) > 0) { %>
          <div class="liq-det-item">
            <div class="liq-det-lbl">Bicis</div>
            <div class="liq-det-val"><%= money(dato.bicis) %></div>
          </div>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="msg warning">No se encontraron datos para la UF <%= item.uf %> en la liquidación de <%= mesLabel %>.</div>
    <% } %>
  <% }); %>
  <% } else if (!error) { %>
    <div class="msg warning">No se encontraron datos en la liquidación de <%= mesLabel %>.</div>
  <% } %>
</section>
<% } %>
<%- include('footer') %>
