<%- include('header') %>
<h1>Mi Liquidación — <%= mesLabel %></h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (dato) { %>
<div class="card" style="overflow-x:auto">
  <table class="tabla-liq">
    <thead>
      <tr>
        <th class="col-uf">UF</th>
        <th>Depto</th>
        <th>Propietario</th>
        <th>% Coef</th>
        <th class="col-money">Exp. Adeudadas</th>
        <th class="col-money">Pagos</th>
        <th class="col-money col-deuda">Deuda</th>
        <th class="col-money">Exp de Mes</th>
        <th class="col-money">Extraordinaria</th>
        <th class="col-money">Sum</th>
        <th class="col-money">Destapación</th>
        <th class="col-money">Bicis</th>
        <th class="col-money col-venc">1er Venc</th>
        <th class="col-money col-venc">2do Venc</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="col-uf"><strong><%= dato.uf %></strong></td>
        <td><%= dato.depto %></td>
        <td><%= dato.propietario %></td>
        <td class="num"><%= dato.coef %></td>
        <td class="num">$<%= dato.expAdeudadas %></td>
        <td class="num green">$<%= dato.pagos %></td>
        <td class="num col-deuda"><strong>$<%= dato.deuda %></strong></td>
        <td class="num">$<%= dato.expMes %></td>
        <td class="num">$<%= dato.extraordinaria %></td>
        <td class="num">$<%= dato.sum %></td>
        <td class="num">$<%= dato.destapacion %></td>
        <td class="num">$<%= dato.bicis %></td>
        <td class="num col-venc"><strong>$<%= dato.venc1 %></strong></td>
        <td class="num col-venc"><strong>$<%= dato.venc2 %></strong></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="grid-2" style="margin-top:16px">
  <div class="card card-venc">
    <h3>📅 1er Vencimiento</h3>
    <div class="venc-fecha"><%= dia1 %>/<%= mesVenc %>/<%= anioVenc %></div>
    <div class="venc-monto">$<%= dato.venc1 %></div>
  </div>
  <div class="card card-venc2">
    <h3>📅 2do Vencimiento (+3%)</h3>
    <div class="venc-fecha"><%= dia2 %>/<%= mesVenc %>/<%= anioVenc %></div>
    <div class="venc-monto">$<%= dato.venc2 %></div>
  </div>
</div>
<% } else if (!error) { %>
<div class="msg warning">No se encontraron datos para tu UF en la liquidación de <%= mesLabel %>.</div>
<% } %>
<%- include('footer') %>
