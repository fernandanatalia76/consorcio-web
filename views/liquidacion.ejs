<%- include('header') %>
<%
  function toNum(v){
    if (v==null) return 0;
    var s = String(v).replace(/[^\d.,-]/g,'');
    if (!s) return 0;
    if (s.indexOf(',')!==-1) {
      s = s.replace(/\./g,'').replace(',','.');
    } else if (s.indexOf('.')!==-1) {
      var partes = s.split('.');
      var ultima = partes[partes.length-1];
      if (ultima.length === 3) s = partes.join('');
    }
    var n = parseFloat(s); return isNaN(n) ? 0 : n;
  }
%>
<h1>Mi Liquidación<% if (mesLabel) { %> — <%= mesLabel %><% } %></h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>

<% if (cache && cache.publicado) { %>
<div class="cache-banner">
  <span class="cache-info">📅 Datos publicados el <strong><%= new Date(cache.fechaHora).toLocaleString('es-AR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) %></strong></span>
  <% if (cache.esAdmin) { %>
    <form method="POST" action="/admin/liquidacion/actualizar" style="display:inline">
      <input type="hidden" name="origen" value="/mi-liquidacion">
      <button type="submit" class="btn btn-sm">🔄 Actualizar datos</button>
    </form>
  <% } %>
</div>
<% } else { %>
<div class="cache-vacio">
  <div class="cache-vacio-icono">📋</div>
  <h3>La administración todavía no publicó los datos de Liquidación</h3>
  <% if (cache && cache.esAdmin) { %>
    <p>Tocá el botón para leer los datos de la planilla y publicarlos para todos los consorcistas.</p>
    <form method="POST" action="/admin/liquidacion/actualizar">
      <input type="hidden" name="origen" value="/mi-liquidacion">
      <button type="submit" class="btn btn-primary" style="width:auto;padding:10px 20px">🔄 Publicar / Actualizar datos</button>
    </form>
  <% } else { %>
    <p>Cuando la administración actualice los datos del mes, van a aparecer acá.</p>
  <% } %>
</div>
<% } %>

<% if (cache && cache.publicado && datos && datos.length) { %>
  <% datos.forEach(function(item, idx) {
       var dato = item.dato;
       var tipoLabel = item.tipo === 'inquilino' ? 'inquilino' : 'propietario';
  %>
    <% if (datos.length > 1) { %>
    <h2 style="margin-top:<%= idx===0 ? '20px' : '32px' %>;color:#1a4a6e">
      UF <%= item.uf %><%
        var desc = [];
        if (item.depto) desc.push(item.depto);
        if (item.tipoUf) desc.push(item.tipoUf);
        if (desc.length) {
      %> <span style="font-weight:normal;color:#5f6368;font-size:15px">— <%= desc.join(' · ') %></span><% } %>
      <span class="chip-tipo <%= tipoLabel %>" style="font-size:11px;vertical-align:middle"><%= tipoLabel %></span>
    </h2>
    <% } %>

    <% if (dato) {
         var deudaNum = toNum(dato.deuda);
         var expMesNum = toNum(dato.expMes);
         var mostrarAdvertencia = deudaNum > 0 && expMesNum > 0 && deudaNum > (expMesNum * 2);
    %>
      <% if (mostrarAdvertencia) { %>
      <div class="alerta-legal">
        <div class="alerta-icono">⚠️</div>
        <div class="alerta-texto">
          <strong>Aviso importante</strong><br>
          De no abonar el monto adeudado de la UF <%= item.uf %>, se iniciarán las acciones legales correspondientes.
        </div>
      </div>
      <% } %>

      <div class="card" style="overflow-x:auto">
        <table class="tabla tabla-striped rtable">
          <thead>
            <tr>
              <th>UF</th><th>Depto</th><th>Propietario</th><th>% Coef</th>
              <th>Exp. Adeudadas</th><th>Pagos</th><th class="col-deuda">Deuda</th>
              <th>Exp de Mes</th><th>Extraordinaria</th><th>Sum</th>
              <th>Destapación</th><th>Bicis</th>
              <th class="col-venc1">1er Venc</th><th class="col-venc2">2do Venc</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="UF"><strong><%= dato.uf %></strong></td>
              <td data-label="Depto"><%= dato.depto %></td>
              <td data-label="Propietario"><%= dato.propietario %></td>
              <td data-label="% Coef"><%= dato.coef %></td>
              <td data-label="Exp. Adeudadas">$<%= dato.expAdeudadas %></td>
              <td data-label="Pagos">$<%= dato.pagos %></td>
              <td data-label="Deuda" class="col-deuda"><strong>$<%= dato.deuda %></strong></td>
              <td data-label="Exp de Mes">$<%= dato.expMes %></td>
              <td data-label="Extraordinaria">$<%= dato.extraordinaria %></td>
              <td data-label="Sum">$<%= dato.sum %></td>
              <td data-label="Destapación">$<%= dato.destapacion %></td>
              <td data-label="Bicis">$<%= dato.bicis %></td>
              <td data-label="1er Venc" class="col-venc1"><strong>$<%= dato.venc1 %></strong></td>
              <td data-label="2do Venc" class="col-venc2"><strong>$<%= dato.venc2 %></strong></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="grid-2" style="margin-top:16px">
        <div class="card card-venc1">
          <h3>📅 1er Vencimiento</h3>
          <div class="venc-fecha"><%= dia1 %>/<%= mesVenc %>/<%= anioVenc %></div>
          <div class="venc-monto">$<%= dato.venc1 %></div>
        </div>
        <div class="card card-venc2">
          <h3>📅 2do Vencimiento (+3%)</h3>
          <div class="venc-fecha"><%= dia2 %>/<%= mesVenc %>/<%= anioVenc %></div>
          <div class="venc-monto">$<%= dato.venc2 %></div>
        </div>
      </div>
    <% } else { %>
      <div class="msg warning">No se encontraron datos para la UF <%= item.uf %> en la liquidación de <%= mesLabel %>.</div>
    <% } %>
  <% }); %>
<% } else if (cache && cache.publicado && !error) { %>
  <div class="msg warning">No se encontraron datos en la liquidación de <%= mesLabel %>.</div>
<% } %>
<%- include('footer') %>
