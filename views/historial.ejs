<%- include('header') %>
<h1>Historial de Pagos</h1>
<% if (error) { %><div class="msg error"><%= error %></div><% } %>
<% if (pagos.length) { %>
<div class="card">
  <table class="tabla">
    <thead>
      <tr><th>Estado</th><th>Monto Cobrado</th><th>Fecha Pago</th><th>Pendiente</th></tr>
    </thead>
    <tbody>
      <% pagos.forEach(function(p) { %>
      <tr>
        <td><span class="badge <%= p.estado === 'Pago total' ? 'badge-ok' : 'badge-warn' %>"><%= p.estado || 'Pendiente' %></span></td>
        <td class="num">$<%= p.montoCobrado || '0' %></td>
        <td><%= p.fechaPago || '—' %></td>
        <td class="num">$<%= p.montoPendiente || '0' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } else if (!error) { %>
<div class="msg warning">No se encontraron pagos registrados para tu UF.</div>
<% } %>
<%- include('footer') %>
