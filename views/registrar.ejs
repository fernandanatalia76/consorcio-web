<%- include('header') %>
<div class="auth-card">
  <h1>🏢 Consorcio</h1>
  <h2>Solicitar acceso</h2>
  <% if (error) { %><div class="msg error"><%= error %></div><% } %>
  <% if (ok) { %><div class="msg success">✅ Solicitud registrada. El administrador te asignará una contraseña y la recibirás por email.</div><% } else { %>
  <form method="POST" action="/registrar">
    <label>N° de Unidad Funcional</label>
    <input type="text" name="uf" placeholder="Ej: 10" required>
    <label>CUIT (11 dígitos, sin guiones)</label>
    <input type="text" name="cuit" placeholder="Ej: 20123456789" maxlength="11" required>
    <label>Email</label>
    <input type="email" name="email" placeholder="Ej: nombre@gmail.com" required>
    <button type="submit" class="btn btn-primary">Solicitar acceso</button>
  </form>
  <% } %>
  <p class="auth-link"><a href="/login">← Volver al login</a></p>
</div>
<%- include('footer') %>
