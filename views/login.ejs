<%- include('header') %>
<div class="login-logo">
  <svg width="56" height="45" viewBox="0 0 100 100" aria-hidden="true">
    <rect x="10" y="20" width="80" height="60" rx="12" fill="#1A1035"/>
    <polygon points="28,38 38,50 28,62" fill="#5A4A9E"/>
    <polygon points="42,32 60,50 42,68" fill="#8F7BD6"/>
    <polygon points="64,26 84,50 64,74" fill="#E9FF3D"/>
  </svg>
  <span class="login-logo-text">Flow<span class="login-logo-it">it</span></span>
</div>
<div class="auth-card">
  <% if (!consorcioElegido) { %>
    <h1>Portal de Consorcios</h1>
    <h2>Elegí tu consorcio</h2>
    <% if (error) { %><div class="msg error"><%= error %></div><% } %>
    <form method="GET" action="/login">
      <label>Consorcio</label>
      <select name="c" required style="width:100%;padding:10px;margin-bottom:16px">
        <option value="" disabled selected>Elegí un consorcio…</option>
        <% consorcios.forEach(function(c){ %>
          <option value="<%= c.spreadsheetId %>"><%= c.nombre %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn btn-primary">Continuar</button>
    </form>
  <% } else { %>
    <h1><%= consorcioElegido.nombre %></h1>
    <h2>Iniciar sesión</h2>
    <% if (error) { %><div class="msg error"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <input type="hidden" name="consorcioId" value="<%= consorcioElegido.spreadsheetId %>">
      <label>N° de Unidad Funcional</label>
      <input type="text" name="uf" placeholder="Ej: 10" required>
      <label>Soy</label>
      <div class="tipo-radios">
        <label class="tipo-opt"><input type="radio" name="tipo" value="propietario" checked> Propietario</label>
        <label class="tipo-opt"><input type="radio" name="tipo" value="inquilino"> Inquilino</label>
      </div>
      <label>Contraseña</label>
      <input type="password" name="password" required>
      <button type="submit" class="btn btn-primary">Ingresar</button>
    </form>
    <p class="auth-link"><a href="/login">← Elegir otro consorcio</a></p>
    <p class="auth-link">¿Primera vez? <a href="/registrar?c=<%= encodeURIComponent(consorcioElegido.spreadsheetId) %>">Registrate acá</a></p>
  <% } %>
</div>
<%- include('footer') %>
